# Local Docker Compose settings. Replace the database password before any
# deployment beyond a private local development machine.
APP_ENV=development
APP_TIMEZONE=America/La_Paz
APP_PUBLIC_URL=http://localhost:8080
API_PREFIX=/api
COOKIE_SECURE=false
APP_RATE_LIMIT_KEY=development-only-rate-limit-key-change-before-use
AI_PREVIEW_SIGNING_KEY=development-only-preview-signing-key-change-before-use-000000000000
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

MONGO_ROOT_USERNAME=scesi_dev
MONGO_ROOT_PASSWORD=local-only-change-before-deployment
MONGODB_DATABASE=scesi_automation
MONGODB_URI=mongodb://scesi_dev:local-only-change-before-deployment@localhost:27017/?replicaSet=rs0&directConnection=true&authSource=admin

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_KEY_ID=local-v1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GOOGLE_DRIVE_ROOT_ID=

LLM_PROVIDER=disabled
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# Provisional public table values. Confirm the organization's plan and limits.
GROQ_LIMIT_RPM=30
GROQ_LIMIT_RPD=1000
GROQ_LIMIT_TPM=8000
GROQ_LIMIT_TPD=200000
GROQ_LIMIT_ITPM=
GROQ_LIMIT_OTPM=
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_TOKENS=2000
LLM_MAX_OUTPUT_TOKENS=750
LLM_MAX_PASSES=2
LLM_MAX_ANALYSIS_TOKENS=6000
LLM_MAX_RETRIES=2

TEMPLATE_FOOTER_PHONES=[]
TEMPLATE_FOOTER_URL=https://scesi.org
TEMPLATE_QR_URL=https://scesi.org
TEMPLATE_FOOTER_EMAIL=contacto@scesi.org
TEMPLATE_FOOTER_ADDRESS="Bloque central de la FCyT, último piso, UMSS"
EMAIL_LOGO_URL=https://i.imgur.com/npTbdR8.png
